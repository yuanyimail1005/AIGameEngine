# Script mode: converts a list of .spv files into a C++ header/source pair of embedded byte arrays.
# Inputs: OUTPUT_HEADER, OUTPUT_SOURCE, SPV_FILES (semicolon list)
set(header_text "// Generated by EmbedShaders.cmake - do not edit.\n#pragma once\n\n#include <cstddef>\n#include <cstdint>\n#include <span>\n#include <string_view>\n\nnamespace Ember::EmbeddedShaders {\n\n")
set(source_text "// Generated by EmbedShaders.cmake - do not edit.\n#include \"EmberShaders.h\"\n\nnamespace Ember::EmbeddedShaders {\n\n")
set(table_text "")

foreach(spv ${SPV_FILES})
	get_filename_component(name "${spv}" NAME_WE)
	file(READ "${spv}" hex HEX)
	string(LENGTH "${hex}" hex_len)
	math(EXPR byte_count "${hex_len} / 2")
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	string(APPEND header_text "\textern const uint8_t g_${name}[${byte_count}];\n")
	string(APPEND source_text "\talignas(4) const uint8_t g_${name}[${byte_count}] = { ${bytes} };\n")
	string(APPEND table_text "\t\t{ \"${name}\", std::span<const uint8_t>(g_${name}, ${byte_count}) },\n")
endforeach()

string(APPEND header_text "\n\tstruct ShaderBlob\n\t{\n\t\tstd::string_view Name;\n\t\tstd::span<const uint8_t> Data;\n\t};\n\n")
string(APPEND header_text "\t// Returns the embedded SPIR-V for <ShaderName>_<stage> (e.g. \"Mesh_vert\"), or an empty span.\n")
string(APPEND header_text "\tstd::span<const uint8_t> Find(std::string_view name);\n\n}\n")

string(APPEND source_text "\n\tstatic const ShaderBlob s_Shaders[] = {\n${table_text}\t};\n\n")
string(APPEND source_text "\tstd::span<const uint8_t> Find(std::string_view name)\n\t{\n\t\tfor (const ShaderBlob& blob : s_Shaders)\n\t\t{\n\t\t\tif (blob.Name == name)\n\t\t\t\treturn blob.Data;\n\t\t}\n\t\treturn {};\n\t}\n\n}\n")

file(WRITE "${OUTPUT_HEADER}.tmp" "${header_text}")
file(WRITE "${OUTPUT_SOURCE}.tmp" "${source_text}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT_HEADER}.tmp" "${OUTPUT_HEADER}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT_SOURCE}.tmp" "${OUTPUT_SOURCE}")
file(REMOVE "${OUTPUT_HEADER}.tmp" "${OUTPUT_SOURCE}.tmp")
